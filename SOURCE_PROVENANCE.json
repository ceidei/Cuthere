  "release_changes": [
    "curated source export",
    "new installer and agent handoff",
    "independent minimal CEP adapter",
    "portable skill and documentation",
    "scope and host restrictions recorded",
    "single CEP extension and panel",
    "bridge auto-start within capture panel",
    "legacy bridge backup and retirement",
    "install failure rollback and uninstall restore",
    "one-panel and migration integration tests",
    "live Windows/Premiere F8-to-agent-edit acceptance",
    "explicit target sequence extraction and multi-sequence input guard",
    "tested dependency lock",
    "previous installation runtime record restored with panel rollback",
    "UTF-8 CLI output",
    "public privacy repack: generic test fixture, removed internal commit identifier, licensing and distribution notes",
    "Cuthere branding with preserved installation IDs, protocol and copyright notice",
    "1.0.1: thin dark scrollbars, dark native controls, actual installed Cuthere menu and UI verification"
  ],
